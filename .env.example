# Copy to .env for local use. Configure these as server secrets on your host.
# Admin sign-in stays disabled until both values are set.
ADMIN_USERNAME=
# Use a unique password of at least 16 characters. Never use a VITE_ prefix.
ADMIN_PASSWORD=
PORT=3000
# Netlify Functions disables require(ESM) by default; the patched HTML sanitizer needs it.
# Configure through Netlify environment variables (including Functions scope) before deployment.
NODE_OPTIONS=--experimental-require-module
# Enable only when the server is behind exactly one trusted reverse proxy.
TRUST_PROXY=0

# Email delivery: Netlify Production context only. Local/deploy previews never send email.
# Leave disabled until a sending provider is agreed, configured and verified.
ENQUIRY_EMAIL_ENABLED=false
ENQUIRY_EMAIL_PROVIDER=microsoft
RESEND_API_KEY=
# Optional Resend alternative only: choose ENQUIRY_EMAIL_PROVIDER=resend to use it.
# A sender on the domain verified with Resend (not the visitor's address).
ENQUIRY_EMAIL_FROM=

# Client-owned single-tenant Microsoft Entra WEB application.
# Set these privately on the server; never use VITE_ prefixes or share secret values in chat.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Register this exact Web redirect URI with Microsoft (use the final HTTPS domain for production).
MICROSOFT_REDIRECT_URI=http://localhost:3002/api/email/microsoft/callback
# A unique base64-encoded 32-byte encryption key; losing it requires reconnecting the mailbox.
EMAIL_TOKEN_ENCRYPTION_KEY=

# Newsletter campaigns: separate from Microsoft enquiry notifications.
# Local/deploy previews never email a campaign. Production requires every setting below.
NEWSLETTER_EMAIL_ENABLED=false
NEWSLETTER_FROM=
NEWSLETTER_SITE_URL=
NEWSLETTER_POSTAL_ADDRESS=
# Stable random secret, at least 32 characters. Keep it to preserve old unsubscribe links.
NEWSLETTER_UNSUBSCRIBE_SECRET=
# Resend webhook signing secret. Configure email.bounced and email.complained events.
NEWSLETTER_WEBHOOK_SECRET=
